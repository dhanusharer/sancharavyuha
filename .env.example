# ==============================================================================
# Sanchara Vyuha Environment Configuration Template
# WeMakeDevs x AWS Environmental Hacks 2026 - Track 03: Waste and Energy
# Subtrack: Public Transport & Green Mobility
# ==============================================================================

# Core Platform Settings
PROJECT_NAME="Sanchara Vyuha Green Mobility Intelligence Platform"
API_V1_STR=/api/v1
DATABASE_URL=sqlite:///./sanchara_vyuha.db
PORT=8000
HOST=0.0.0.0

# Computer Vision Edge Detection
YOLO_MODEL=yolov8s.pt
CONF_THRESHOLD=0.5
OVERCROWDING_THRESHOLD_PCT=90.0

# Environmental Sustainability & Carbon Accounting (CPCB / ARAI / CEA Standards)
# Central Pollution Control Board (CPCB) Standard BS-VI Diesel Combustion Factor (kg CO2 / L)
CARBON_FACTOR_DIESEL_KG_PER_L=2.68

# Central Electricity Authority (CEA) India 2024-25 National Grid Baseline (kg CO2 / kWh)
CARBON_FACTOR_EV_KG_PER_KWH=0.72

# ARAI 12-meter Urban City Bus Fuel Consumption (Liters / km)
DIESEL_BUS_CONSUMPTION_L_PER_KM=0.33

# Electric Bus Grid Energy Consumption (kWh / km)
EV_BUS_CONSUMPTION_KWH_PER_KM=1.15

# Baseline Deadhead Unoptimized Running Rate
BASELINE_DEADHEAD_RATE=0.148

# Minimum Transit Service Headway Guarantee (Minutes)
MIN_SERVICE_HEADWAY_MINS=15.0

# ==============================================================================
# AWS Cloud Integration (Amazon S3 & Amazon CloudWatch)
# Note: Never commit real credentials. If credentials are empty or USE_AWS_MOCK=true,
# the system automatically uses the resilient local S3 and CloudWatch adapters.
# ==============================================================================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id-placeholder
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-placeholder
AWS_S3_BUCKET_NAME=sanchara-vyuha-audit-archive-2026
AWS_CLOUDWATCH_NAMESPACE=SancharaVyuha/PublicTransport

# Set to true to force local mock adapter even if AWS credentials exist
USE_AWS_MOCK=false
